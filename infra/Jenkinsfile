pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        chmod +x infra/scripts/sonar-analysis.sh
                        ./infra/scripts/sonar-analysis.sh
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                waitForQualityGate abortPipeline: true
            }
        }
    }

    post {
        always {
            script {
                def recipient = env.GMAIL_USER ?: 'dvddavid677@gmail.com'

                def html = readFile('infra/templates/email-report.html')

                emailext(
                    to: recipient,
                    subject: "[Jenkins] ${currentBuild.currentResult}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    mimeType: 'text/html',
                    body: html
                )
            }
        }
    }
}