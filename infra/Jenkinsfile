pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonarqube-credentials')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Generates coverage.out per service before scanning
        stage('Test Coverage') {
            steps {
                sh '''
                    chmod +x infra/scripts/sonar/sonar-coverage.sh
                    ./infra/scripts/sonar/sonar-coverage.sh
                '''
            }
        }

        // Runs SonarScanner per service using coverage reports
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        chmod +x infra/scripts/sonar/sonar-analysis.sh
                        ./infra/scripts/sonar/sonar-analysis.sh
                    '''
                }
            }
        }

        // Validates Quality Gate per service via SonarQube API
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    sh '''
                        chmod +x infra/scripts/sonar/sonar-gate.sh
                        ./infra/scripts/sonar/sonar-gate.sh
                    '''
                }
            }
        }

        // Fetches all metrics from SonarQube API into /tmp/sonar-metrics.env
        stage('Fetch Metrics') {
            steps {
                sh '''
                    chmod +x infra/scripts/sonar/sonar-metrics.sh
                    ./infra/scripts/sonar/sonar-metrics.sh
                '''
            }
        }

        // Runs Postman black-box tests via Newman
        stage('Black-box Tests') {
            steps {
                sh '''
                    newman run infra/collections/Beer-Collection.postman_collection.json \
                        --reporters cli,json,junitfull \
                        --reporter-json-export /tmp/newman-results.json \
                        --reporter-junitfull-export /tmp/newman-results.xml
                '''
            }
            post {
                always {
                    // Parse Newman results and append to metrics file
                    sh '''
                        chmod +x infra/scripts/newman/newman-report.sh
                        ./infra/scripts/newman/newman-report.sh
                    '''
                    junit '/tmp/newman-results.xml'
                }
            }
        }

    }

    post {
        always {
            script {
                // Orchestrate full HTML report from sonar and newman metrics
                sh '''
                    chmod +x infra/scripts/build-report.sh
                    ./infra/scripts/build-report.sh
                '''

                // Read rendered report and inject Jenkins build variables
                def html = readFile('/tmp/email-report-rendered.html')

                html = html.replace('${BUILD_RESULT}',    currentBuild.currentResult   ?: 'UNKNOWN')
                html = html.replace('${BUILD_DURATION}',  currentBuild.durationString  ?: 'N/A')
                html = html.replace('${BRANCH_NAME}',     env.BRANCH_NAME              ?: 'main')
                html = html.replace('${JOB_NAME}',        env.JOB_NAME                 ?: 'GoBrew')
                html = html.replace('${BUILD_NUMBER}',    env.BUILD_NUMBER             ?: '0')
                html = html.replace('${BUILD_URL}',       env.BUILD_URL                ?: '#')
                html = html.replace('${GIT_COMMIT}',      (env.GIT_COMMIT ?: 'unknown').take(7))
                html = html.replace('${SONAR_URL}',       'http://localhost:9000')
                html = html.replace('${BUILD_TIMESTAMP}', new Date().toString())

                // Send email with full metrics report
                emailext(
                    to:       'dvddavid677@gmail.com',
                    subject:  "[Jenkins] ${currentBuild.currentResult}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    mimeType: 'text/html',
                    body:     html
                )
            }
        }
    }
}