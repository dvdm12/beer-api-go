    {
      "name": "PUT",
      "item": [
        {
          "name": "Update-Beer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const names = ['Duvel','Chimay Blue','Westmalle Tripel','Rochefort 10','Orval','Paulaner Salvator','Erdinger Dunkel','Pilsner Urquell','Asahi Black','Sapporo Premium'];",
                  "const brands = ['Duvel Moortgat','Chimay Brewery','Paulaner Brauerei','Erdinger Weissbräu','Plzensky Prazdroj','Sapporo Breweries','Asahi Group Holdings'];",
                  "const random = arr => arr[Math.floor(Math.random() * arr.length)];",
                  "const randFloat = (min, max) => Number((Math.random() * (max - min) + min).toFixed(1));",
                  "const randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;",
                  "const updatedBeer = { name: random(names), brand: random(brands), alcohol: randFloat(3.5, 12.5), year: randInt(1980, 2025) };",
                  "pm.environment.set('beer_payload', JSON.stringify(updatedBeer));",
                  "console.log('Updating beer id:', pm.environment.get('beer_id'), 'with:', updatedBeer);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response has id', () => pm.expect(pm.response.json()).to.have.property('id'));",
                  "pm.test('response has name', () => pm.expect(pm.response.json()).to.have.property('name'));",
                  "pm.test('content-type is json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
