        {
          "name": "Statistics",
          "item": [
            {
              "name": "Get General Stats",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test('has total', () => pm.expect(body).to.have.property('total'));",
                      "pm.test('has total_brands', () => pm.expect(body).to.have.property('total_brands'));",
                      "pm.test('has avg_alcohol', () => pm.expect(body).to.have.property('avg_alcohol'));",
                      "pm.test('has min_alcohol', () => pm.expect(body).to.have.property('min_alcohol'));",
                      "pm.test('has max_alcohol', () => pm.expect(body).to.have.property('max_alcohol'));",
                      "pm.test('has oldest_year', () => pm.expect(body).to.have.property('oldest_year'));",
                      "pm.test('has newest_year', () => pm.expect(body).to.have.property('newest_year'));",
                      "pm.test('total > 0', () => pm.expect(body.total).to.be.above(0));",
                      "pm.test('min_alcohol <= avg_alcohol', () => pm.expect(body.min_alcohol).to.be.at.most(body.avg_alcohol));",
                      "pm.test('avg_alcohol <= max_alcohol', () => pm.expect(body.avg_alcohol).to.be.at.most(body.max_alcohol));",
                      "pm.test('oldest_year <= newest_year', () => pm.expect(body.oldest_year).to.be.at.most(body.newest_year));"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
