  "item": [
    {
      "name": "POST",
      "item": [
        {
          "name": "Create-Beer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const names = ['Pilsen','Corona','Heineken','Stella Artois','Budweiser','Club Colombia','Aguila','Poker','Coors','Miller','Guinness','Modelo','Cusquena','BBC','Patagonia'];",
                  "const brands = ['Bavaria','Grupo Modelo','AB InBev','Heineken Intl','Coors Co','Quilmes SA','Asahi','Carlsberg Group','Diageo','Kirin Holdings'];",
                  "const random = arr => arr[Math.floor(Math.random() * arr.length)];",
                  "const randFloat = (min, max) => Number((Math.random() * (max - min) + min).toFixed(1));",
                  "const randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;",
                  "const beer = { name: random(names), brand: random(brands), alcohol: randFloat(3.0, 11.0), year: randInt(1985, 2025) };",
                  "pm.environment.set('beer_payload', JSON.stringify(beer));",
                  "console.log('Generated beer:', beer);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('response has id', () => pm.expect(pm.response.json()).to.have.property('id'));",
                  "pm.test('response has name', () => pm.expect(pm.response.json()).to.have.property('name'));",
                  "pm.test('content-type is json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.environment.set('beer_id', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{beer_payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://create_service:8080/beers",
              "protocol": "http",
              "host": [
                "create_service"
              ],
              "port": "8080",
              "path": [
                "beers"
              ]
            }
          },
          "response": []
        }
      ]
