              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.test('is array', () => pm.expect(body).to.be.an('array'));",
                      "pm.test('array not empty', () => pm.expect(body.length).to.be.above(0));",
                      "pm.test('each item has brand', () => body.forEach(b => pm.expect(b).to.have.property('brand')));",
                      "pm.test('each item has count', () => body.forEach(b => pm.expect(b).to.have.property('count')));",
                      "pm.test('each item has avg_alcohol', () => body.forEach(b => pm.expect(b).to.have.property('avg_alcohol')));",
                      "pm.test('min <= avg <= max per brand', () => {",
                      "  body.forEach(b => {",
                      "    pm.expect(b.min_alcohol).to.be.at.most(b.avg_alcohol);",
                      "    pm.expect(b.avg_alcohol).to.be.at.most(b.max_alcohol);",
                      "  });",
                      "});"
